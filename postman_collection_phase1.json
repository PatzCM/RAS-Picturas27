					{
						"key": "Authorization",
						"value": "Bearer {{accessToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/user/project/video/export",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"project",
						"video",
						"export"
					]
				}
			}
		}
	]
}