				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"bucket\": \"{{bucketName}}\",\n    \"inputKey\": \"{{objectKey}}\",\n    \"targetFormat\": \"webm\",\n    \"targetResolution\": \"720p\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/user/project/video/convert",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"project",
						"video",
						"convert"
					]
				}
			}
		},
		{
			"name": "5. Obter URLs de Exportação (GET /user/project/video/export)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
